rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function admin() { return signedIn() && role() == 'admin'; }
    function staff(kind) { return admin() || (signedIn() && ((kind == 'Grooming' && role() == 'pic_grooming') || (kind == 'Klinik' && role() == 'pic_klinik'))); }
    function validRoom(d) { return d.roomId in (d.layanan == 'Grooming' ? ['grooming-1', 'grooming-2'] : ['dokter-1', 'dokter-2']); }
    function validDoctor(d) {
      return !d.keys().hasAny(['doctorId', 'doctorName']) ||
        (d.layanan == 'Klinik' && d.keys().hasAll(['doctorId', 'doctorName']) &&
         ((d.doctorId == 'doctor-1' && d.doctorName == 'Dokter 1' && d.roomId == 'dokter-1') ||
          (d.doctorId == 'doctor-2' && d.doctorName == 'Dokter 2' && d.roomId == 'dokter-2')));
    }
    function validGroomer(d) {
      return !d.keys().hasAny(['groomerId', 'groomerName']) ||
        (d.layanan == 'Grooming' && d.keys().hasAll(['groomerId', 'groomerName']) &&
         ((d.groomerId == 'groomer-1' && d.groomerName == 'Groomer 1' && d.roomId == 'grooming-1') ||
          (d.groomerId == 'groomer-2' && d.groomerName == 'Groomer 2' && d.roomId == 'grooming-2')));
    }
    function identity(d) { return d.keys().hasAll(['roomId','queueSequence','queueNumber']) && validRoom(d) && d.queueSequence is int && d.queueSequence > 0; }
    function countKey(d) { return (d.layanan == 'Grooming' ? 'G-' : 'K-') + d.tanggalRilis; }
    function correctLabel(d) {
      let prefix = d.layanan == 'Grooming' ? 'G-' : 'K-';
      let number = string(d.queueSequence);
      return d.queueNumber == prefix + (d.queueSequence < 10 ? '00' : d.queueSequence < 100 ? '0' : '') + number;
    }
    function allocated(d, id) {
      let path = /databases/$(database)/documents/petshop-app/v1/queue-counters/$(countKey(d));
      let next = getAfter(path).data;
      return identity(d) && correctLabel(d) && next.lastTicketId == id && next.sequence == d.queueSequence &&
        next.sequence == (exists(path) ? get(path).data.sequence + 1 : 1);
    }
    function fieldsValid(d) {
      return d.layanan in ['Grooming','Klinik'] && validRoom(d) && validDoctor(d) && validGroomer(d) &&
        d.nama is string && d.nama.size() > 0 && d.nama.size() <= 200 &&
        d.telepon is string && d.telepon.matches('08[0-9]{8,12}') && d.kontak == d.telepon &&
        d.catatan is string && d.catatan.size() <= 200 &&
        d.tanggalRilis.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        (d.layanan == 'Grooming' ? d.jam.matches('(09|1[0-4]):(00|30)') : d.jam.matches('(09|1[0-7]):00'));
    }
    function vacant(room) {
      let path = /databases/$(database)/documents/petshop-app/v1/room-states/$(room);
      return !exists(path) || get(path).data.ticketId == null;
    }
    function claimed(d, id) { return vacant(d.roomId) && getAfter(/databases/$(database)/documents/petshop-app/v1/room-states/$(d.roomId)).data.ticketId == id; }
    function released(d, id) {
      let path = /databases/$(database)/documents/petshop-app/v1/room-states/$(d.get('roomId', 'legacy'));
      // Legacy active tickets may have no occupancy record. Never release someone else's lock.
      return !exists(path) || get(path).data.ticketId != id || getAfter(path).data.ticketId == null;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if admin() && request.resource.data.role in ['admin','pic_grooming','pic_klinik'];
      allow delete: if admin() && uid != request.auth.uid;
    }
    match /petshop-app/v1/tickets/{id} {
      // Existing public tracking behavior is retained; payload privacy needs a server projection later.
      allow read: if true;
      allow create: if fieldsValid(request.resource.data) && allocated(request.resource.data, id) &&
        request.resource.data.keys().hasOnly(['nama','telepon','kontak','layanan','tanggalRilis','jam','catatan','roomId','queueSequence','queueNumber','status','source','tanggalSelesai','createdAt','startedAt','log','doctorId','doctorName','groomerId','groomerName']) &&
        request.resource.data.createdAt == request.time && request.resource.data.tanggalSelesai == '' &&
        ((request.resource.data.status == 'PENDING' && request.resource.data.source == 'kiosk' && !request.resource.data.keys().hasAny(['startedAt'])) ||
         (admin() && request.resource.data.source == 'admin' &&
          (request.resource.data.status == 'PENDING' || (request.resource.data.status == 'aktif' && request.resource.data.startedAt == request.time && claimed(request.resource.data, id)))));
      allow update: if (
        // Detail edits and one-time numbering of legacy pending/waiting tickets.
        admin() && resource.data.status in ['PENDING','WAITING'] && request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama','telepon','kontak','jam','catatan','roomId','queueSequence','queueNumber','log','doctorId','doctorName','groomerId','groomerName']) &&
        fieldsValid(request.resource.data) &&
        (resource.data.keys().hasAny(['queueSequence']) ?
          (request.resource.data.queueSequence == resource.data.queueSequence && request.resource.data.queueNumber == resource.data.queueNumber) : allocated(request.resource.data, id))
      ) || (
        // Status transitions cannot alter scheduling, room, or queue identity.
        staff(resource.data.layanan) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','log','startedAt','tanggalSelesai']) &&
        ((admin() && resource.data.status == 'PENDING' && request.resource.data.status == 'WAITING' && identity(resource.data)) ||
         (resource.data.status == 'WAITING' && request.resource.data.status == 'aktif' && identity(resource.data) && request.resource.data.startedAt == request.time && claimed(resource.data, id)) ||
         (resource.data.status == 'aktif' && request.resource.data.status == 'PAYMENT' && released(resource.data, id)) ||
         (admin() && resource.data.status == 'PAYMENT' && request.resource.data.status == 'COMPLETED' && request.resource.data.tanggalSelesai is string && request.resource.data.tanggalSelesai.size() > 0) ||
         (resource.data.status in ['PENDING','WAITING','aktif'] && request.resource.data.status == 'CANCELLED' &&
          (resource.data.status != 'PENDING' || admin()) && (resource.data.status != 'aktif' || released(resource.data, id)))) &&
        (request.resource.data.status == 'aktif' || request.resource.data.get('startedAt', null) == resource.data.get('startedAt', null)) &&
        (request.resource.data.status == 'COMPLETED' || request.resource.data.tanggalSelesai == resource.data.tanggalSelesai)
      );
    }
    match /petshop-app/v1/queue-counters/{key} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['sequence','lastTicketId','layanan','tanggalRilis']) &&
        key == countKey(request.resource.data) &&
        request.resource.data.sequence == (resource == null ? 1 : resource.data.sequence + 1) &&
        counterTicket(request.resource.data);
      function counterTicket(d) {
        let path = /databases/$(database)/documents/petshop-app/v1/tickets/$(d.lastTicketId);
        let ticket = getAfter(path).data;
        return (!exists(path) || (admin() && !get(path).data.keys().hasAny(['queueSequence']) && get(path).data.status in ['PENDING','WAITING'])) &&
          ticket.queueSequence == d.sequence && ticket.layanan == d.layanan && ticket.tanggalRilis == d.tanggalRilis;
      }
    }
    match /petshop-app/v1/room-states/{room} {
      allow read: if signedIn();
      allow create, update: if request.resource.data.keys().hasOnly(['ticketId']) && (
        (request.resource.data.ticketId is string && vacant(room) && claimTicket(request.resource.data.ticketId)) ||
        (resource != null && resource.data.ticketId is string && request.resource.data.ticketId == null && releaseTicket(resource.data.ticketId))
      );
      function claimTicket(id) {
        let path = /databases/$(database)/documents/petshop-app/v1/tickets/$(id);
        let ticket = getAfter(path).data;
        return staff(ticket.layanan) && validRoom(ticket) && ticket.roomId == room && ticket.status == 'aktif' &&
          (!exists(path) || get(path).data.status == 'WAITING');
      }
      function releaseTicket(id) {
        let path = /databases/$(database)/documents/petshop-app/v1/tickets/$(id);
        let before = get(path).data;
        let after = getAfter(path).data;
        return staff(before.layanan) && before.roomId == room && before.status == 'aktif' && after.status in ['PAYMENT','CANCELLED'];
      }
    }
    match /petshop-app/v1/system-logs/{id} {
      allow read: if admin();
      allow create: if request.resource.data.timestamp == request.time &&
        request.resource.data.actorId == (signedIn() ? request.auth.uid : null) &&
        logTicket(request.resource.data);
      function logTicket(d) {
        let path = /databases/$(database)/documents/petshop-app/v1/tickets/$(d.ticketId);
        let ticket = getAfter(path).data;
        return (staff(ticket.layanan) || (!exists(path) && ticket.status == 'PENDING' && ticket.createdAt == request.time)) &&
          d.toStatus == ticket.status && d.layanan == ticket.layanan && d.nama == ticket.nama;
      }
    }
  }
}
